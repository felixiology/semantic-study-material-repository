// Paste this into https://dbdiagram.io/d to view or edit the ER diagram.
Table users {
  user_id serial [pk]
  name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password_hash text [not null]
  role varchar(10) [not null, note: "admin | faculty | student"]
  created_at timestamp [not null]
  last_login timestamp
}
Table courses {
  course_id serial [pk]
  code varchar(20) [unique, not null]
  name varchar(150) [not null]
  faculty_id int [not null]
}
Table enrollments {
  student_id int [pk]
  course_id int [pk]
  enrolled_on date [not null]
}
Table documents {
  doc_id serial [pk]
  course_id int [not null]
  uploaded_by int [not null]
  title varchar(200) [not null]
  file_type varchar(10) [not null]
  status varchar(12) [not null]
  chunk_count int [not null]
  upload_date timestamp [not null]
  description text
  indexes { (course_id, title) [unique] }
}
Table document_chunks {
  chunk_id serial [pk]
  doc_id int [not null]
  chunk_index int [not null]
  page_no int
  content text [not null]
  embedding vector(384)
  content_tsv tsvector
  indexes { (doc_id, chunk_index) [unique] }
}
Table bookmarks {
  user_id int [pk]
  chunk_id int [pk]
  created_at timestamp [not null]
}
Table document_audit {
  audit_id serial [pk]
  doc_id int
  title varchar(200)
  action varchar(10) [not null]
  performed_at timestamp [not null]
  Note: "No foreign keys on purpose: rows must survive document deletion"
}

Ref: courses.faculty_id > users.user_id
Ref: enrollments.student_id > users.user_id
Ref: enrollments.course_id > courses.course_id
Ref: documents.course_id > courses.course_id
Ref: documents.uploaded_by > users.user_id
Ref: document_chunks.doc_id > documents.doc_id
Ref: bookmarks.user_id > users.user_id
Ref: bookmarks.chunk_id > document_chunks.chunk_id

// NoSQL (MongoDB) collection, database "study_repo", not part of the SQL schema:
